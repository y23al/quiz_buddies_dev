rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザー認証チェック
    function isAuthenticated() {
      return request.auth != null;
    }

    // 本人チェック
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ルームメンバーチェック
    function isRoomMember(roomId) {
      return request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUserIds;
    }

    // ユーザー
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false; // 削除は管理者のみ
    }

    // セッション
    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false; // Cloud Functionsのみ
    }

    // クイズ
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false; // Cloud Functionsのみ
    }

    // 参加情報
    match /participations/{participationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        participationId.matches(request.auth.uid + '$');
      allow update: if isAuthenticated() &&
        participationId.matches(request.auth.uid + '$');
      allow delete: if false;
    }

    // ルーム
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if false; // Cloud Functionsのみ
      allow update: if isAuthenticated(); // メンバー追加用
      allow delete: if false;

      // メッセージ
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.senderUserId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // 通報
    match /reports/{reportId} {
      allow read: if false; // 管理者のみ
      allow create: if isAuthenticated() &&
        request.resource.data.reporterUserId == request.auth.uid;
      allow update, delete: if false;
    }

    // イベントログ
    match /events/{eventId} {
      allow read: if false; // 管理者のみ
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
